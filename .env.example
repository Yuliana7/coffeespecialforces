# SQLite database file (relative paths are resolved from the project root)
DATABASE_URI=file:./coffeesf.db

# Long random string used to sign Payload auth tokens. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Public origin of the site, used in production for absolute URLs, CORS and the
# CSRF allowlist. It MUST match the origin the site is actually served from, or
# Payload will reject every save in the admin panel. Ignored in development,
# where the origin is taken from the request instead.
NEXT_PUBLIC_SERVER_URL=https://example.org

# Credentials for the admin user created by `pnpm seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
