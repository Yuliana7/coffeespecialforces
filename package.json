{
  "name": "coffeespecialforces",
  "version": "0.1.0",
  "description": "Coffee Special Forces — charity coffee shop website & CMS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8000 next build",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "graphql": "^16.8.1",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.4.2",
    "railway": "^3.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
